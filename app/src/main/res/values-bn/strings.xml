    <string name="info_chime">ফোন লক থাকলেও Niko Clock সারাদিন নির্দিষ্ট সময়ে নিজে থেকে সময় বলে। বোতাম চাপলে বা ফোন ঝাঁকালেও সবসময় বলে।</string>
    <string name="info_quiet_hours">এই সময়ে নিয়মিত ঘোষণা হয় না, যাতে রাতে কারও ঘুম না ভাঙে। সময়ে ছুঁলে, বোতাম চাপলে বা ঝাঁকালে তবুও বলে।</string>
    <string name="info_dnd">ফোন বিরক্ত করবেন না মোডে থাকলে নিয়মিত ঘোষণা হয় না। নিজে জানতে চাইলে তবুও বলে।</string>
    <string name="info_shake">স্ক্রিন বন্ধ ও লক থাকলেও ফোন দ্রুত কয়েকবার ঝাঁকিয়ে সময় শুনুন। সঙ্গে সঙ্গে আবার ঝাঁকালে তারিখ শুনবেন। হাঁটলে বা ফোন রাখলে চালু হয় না। একটু বেশি ব্যাটারি লাগে।</string>
    <string name="info_battery">কিছু ফোন ব্যাটারি বাঁচাতে পটভূমির অ্যাপ বন্ধ করে দেয়। এতে ঘোষণা ও ঝাঁকানো বন্ধ হতে পারে। Niko Clock-কে কোনো বিধিনিষেধ ছাড়া রাখুন।</string>
    <string name="info_pin">৪ সংখ্যার PIN সেটিংস ভুল করে বদলানো থেকে রক্ষা করে। ঘড়ি নিজে এটি ছাড়াই সবসময় চলে।</string>
